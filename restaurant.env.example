# Restaurant deployment configuration
# Copy these values into the Vercel project Environment Variables for each restaurant.

RESTAURANT_ID=restaurant_slug
RESTAURANT_NAME=Restaurant Name
RESTAURANT_SHORT_NAME=Restaurant
RESTAURANT_WHATSAPP=5210000000000
APP_PUBLIC_URL=https://restaurant.example.com
RESTAURANT_LOGO_URL=https://restaurant.example.com/logo.png
RESTAURANT_ICON_192_URL=https://restaurant.example.com/icon-192.png
RESTAURANT_ICON_512_URL=https://restaurant.example.com/icon-512.png
RESTAURANT_PRIMARY_COLOR=#6a0dad
RESTAURANT_ACCENT_COLOR=#ffcc00
RESTAURANT_TIMEZONE=America/Cancun
RESTAURANT_CURRENCY=MXN
RESTAURANT_LOCALE=es-MX
RESTAURANT_ADDRESS_SUFFIX=City, State, Mexico
RESTAURANT_LATITUDE=0
RESTAURANT_LONGITUDE=0

MODULE_LOYALTY=true
MODULE_DELIVERY=false
MODULE_MISSIONS=true
MODULE_REVIEWS=true

FIREBASE_PROJECT_ID=
FIREBASE_DATABASE_URL=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

ONESIGNAL_APP_ID=
ONESIGNAL_REST_KEY=

GOOGLE_ROUTES_API_KEY=
GOOGLE_MAPS_BROWSER_KEY=

DASHBOARD_PASSWORD=
ADMIN_SESSION_SECRET=
CLIENT_SESSION_SECRET=
CRON_SECRET=

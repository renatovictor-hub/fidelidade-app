# Restaurant identity
RESTAURANT_ID=restaurant_slug
RESTAURANT_NAME=Restaurant Name
RESTAURANT_SHORT_NAME=Restaurant
APP_PUBLIC_URL=https://app.example.com
RESTAURANT_LOGO_URL=https://app.example.com/logo.png
RESTAURANT_ICON_192_URL=https://app.example.com/icon-192.png
RESTAURANT_ICON_512_URL=https://app.example.com/icon-512.png
RESTAURANT_PRIMARY_COLOR=#6a0dad
RESTAURANT_ACCENT_COLOR=#ffcc00
RESTAURANT_WHATSAPP=5210000000000
RESTAURANT_INSTAGRAM_URL=
RESTAURANT_TIMEZONE=America/Cancun
RESTAURANT_CURRENCY=MXN
RESTAURANT_LOCALE=es-MX
RESTAURANT_ADDRESS_SUFFIX=Cancún, Quintana Roo, México
RESTAURANT_LATITUDE=0
RESTAURANT_LONGITUDE=0

# Modules sold to this restaurant
MODULE_LOYALTY=true
MODULE_DELIVERY=false
MODULE_MISSIONS=true
MODULE_REVIEWS=true
LEGACY_CATALOG_FALLBACK=false

# Firebase - unique project per restaurant
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_DATABASE_URL=

# OneSignal - unique app per restaurant
ONESIGNAL_APP_ID=
ONESIGNAL_REST_KEY=

# Google Cloud - unique keys/project per restaurant when Delivery is enabled
GOOGLE_ROUTES_API_KEY=
GOOGLE_MAPS_BROWSER_KEY=
DELIVERY_RAIN_ACTIVE=false

# Installation security - unique random values per restaurant
DASHBOARD_PASSWORD=
ADMIN_SESSION_SECRET=
CLIENT_SESSION_SECRET=
CRON_SECRET=
